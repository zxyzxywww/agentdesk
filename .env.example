# ============ AgentDesk 密钥配置 ============
# 用法：把本文件复制为 .env（同目录），填入真实密钥。
# .env 已被 .gitignore 忽略，不会提交到仓库。
#
# 复制命令（Windows PowerShell）：
#   Copy-Item .env.example .env

# DeepSeek API（OpenAI 兼容）：https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 火山方舟 API：https://console.volcengine.com/ark 创建（当前默认使用，free 额度）
ARK_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxx

# Tavily 搜索 API：https://app.tavily.com 免费注册（每月 1000 次搜索）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
